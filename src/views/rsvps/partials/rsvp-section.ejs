<% const isPast=variant==="past" ; %>

    <section class="mb-6">

        <!-- SECTION TITLE (FIXED + COLORED) -->
        <h2 class="text-xl font-semibold mb-3
    <%= isPast ? 'text-red-600' : 'text-emerald-700' %>">
            <%= title %>
        </h2>

        <% if (items.length===0) { %>
            <p class="text-slate-400 text-sm py-4">
                <%= emptyMessage %>
            </p>
            <% } else { %>

                <div class="overflow-x-auto rounded-xl border border-slate-200">

                    <table class="min-w-full divide-y divide-slate-200 text-sm">

                        <!-- HEADER -->
                        <thead class="
  text-xs uppercase tracking-wide
  <%= isPast ? 'bg-red-50 text-red-600' : 'bg-emerald-50 text-emerald-700' %>
">
                            <tr>
                                <th class="px-4 py-3 text-left w-2/5">Event</th>
                                <th class="px-4 py-3 text-left w-1/5">Date</th>
                                <th class="px-4 py-3 text-left w-1/6">Category</th>
                                <th class="px-4 py-3 text-left w-1/6">Status</th>
                                <th class="px-4 py-3 text-left w-1/6">Actions</th>
                            </tr>
                        </thead>

                        <!-- BODY -->
                        <tbody class="divide-y divide-slate-100 bg-white">

                            <% items.forEach(function(item) { %>

                                <% const event=item.event; const statusColors={ going: "bg-green-100 text-green-700" ,
                                    waitlisted: "bg-yellow-100 text-yellow-700" , cancelled: "bg-red-100 text-red-600" ,
                                    }; const statusClass=statusColors[item.status] || "bg-slate-100 text-slate-600" ; %>

                                    <tr class="
            transition-all duration-150
            hover:bg-slate-50 hover:shadow-sm
            <%= isPast ? 'opacity-70' : '' %>
          ">

                                        <!-- EVENT -->
                                        <td class="px-4 py-4">

                                            <a href="/events/<%= event.id %>"
                                                class="text-lg font-bold text-slate-900 hover:text-slate-700 hover:underline transition-colors">
                                                <%= event.title %>
                                            </a>

                                            <div class="text-xs text-slate-500 mt-1">
                                                <%= event.location %>
                                            </div>

                                            <% if (typeof item.conflictWarning !== "undefined" && item.conflictWarning) { %>
                                            <div class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">
                                                <span>⚠️</span>
                                                <span><%= item.conflictWarning %></span>
                                            </div>
                                            <% } %>

                                        </td>

                                        <!-- DATE -->
                                        <td class="px-4 py-4 text-slate-600 whitespace-nowrap">
                                            <%= event.startDatetime.toLocaleDateString("en-US", { weekday: "short" ,
                                                month: "short" , day: "numeric" , hour: "2-digit" , minute: "2-digit" })
                                                %>
                                        </td>

                                        <!-- CATEGORY -->
                                        <td class="px-4 py-4">
                                            <%- include("../../partials/category-badge", { category: event.category })
                                                %>
                                        </td>

                                        <!-- STATUS -->
                                        <td class="px-4 py-4">
                                            <span
                                                class="inline-block px-2 py-0.5 rounded-full text-xs font-medium capitalize <%= statusClass %>">
                                                <%= item.status %>
                                            </span>
                                        </td>

                                        <!-- ACTIONS -->
                                        <td class="px-4 py-4">

                                            <% if (showCancel) { %>
                                                <form method="post" action="/events/<%= item.eventId %>/rsvp" x-data
                                                    @submit.prevent="if(confirm('Cancel this RSVP?')) $el.submit()">
                                                    <button type="submit"
                                                        class="text-xs px-3 py-1.5 rounded-lg border border-red-300 text-red-600 hover:bg-red-50 transition-colors">
                                                        Cancel
                                                    </button>
                                                </form>
                                                <% } %>

                                        </td>

                                    </tr>

                                    <% }) %>

                        </tbody>
                    </table>

                </div>

                <% } %>
    </section>