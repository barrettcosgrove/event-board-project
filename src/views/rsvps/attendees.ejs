<section class="mb-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Attendee List</h1>
      <p class="mt-1 text-sm text-slate-500">Grouped by RSVP status for this event.</p>
    </div>
    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Organizer View</p>
  </div>
</section>

<%
  const attendeeSource = attendees ?? rsvps ?? [];
  const groups = Array.isArray(attendeeSource)
    ? {
        going: attendeeSource.filter((person) => person.status === "going"),
        waitlisted: attendeeSource.filter((person) => person.status === "waitlisted"),
        cancelled: attendeeSource.filter((person) => person.status === "cancelled"),
      }
    : {
        going: attendeeSource.going ?? [],
        waitlisted: attendeeSource.waitlisted ?? [],
        cancelled: attendeeSource.cancelled ?? [],
      };
%>

<section class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50/40 p-5 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-xl font-semibold text-slate-900 mb-3">Going</h2>
    <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800"><%= groups.going.length %></span>
  </div>
  <% if (groups.going.length === 0) { %>
    <p class="text-slate-500 text-sm">No attendees are currently marked as going.</p>
  <% } else { %>
    <ul class="m-0 grid list-none gap-3 p-0">
      <% groups.going.forEach((person) => { %>
        <li class="flex items-center justify-between rounded-lg border border-emerald-200 bg-white p-4">
          <span class="font-semibold text-slate-900"><%= person.displayName ?? person.userId %></span>
          <span class="text-sm text-slate-500"><%= person.createdAt.toLocaleString() %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="mb-4 rounded-xl border border-amber-200 bg-amber-50/40 p-5 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-xl font-semibold text-slate-900 mb-3">Waitlisted</h2>
    <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800"><%= groups.waitlisted.length %></span>
  </div>
  <% if (groups.waitlisted.length === 0) { %>
    <p class="text-slate-500 text-sm">No attendees are currently waitlisted.</p>
  <% } else { %>
    <ul class="m-0 grid list-none gap-3 p-0">
      <% groups.waitlisted.forEach((person) => { %>
        <li class="flex items-center justify-between rounded-lg border border-amber-200 bg-white p-4">
          <span class="font-semibold text-slate-900"><%= person.displayName ?? person.userId %></span>
          <span class="text-sm text-slate-500"><%= person.createdAt.toLocaleString() %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="mb-0 rounded-xl border border-rose-200 bg-rose-50/40 p-5 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-xl font-semibold text-slate-900 mb-3">Cancelled</h2>
    <span class="rounded-full bg-rose-100 px-2.5 py-1 text-xs font-semibold text-rose-800"><%= groups.cancelled.length %></span>
  </div>
  <% if (groups.cancelled.length === 0) { %>
    <p class="text-slate-500 text-sm">No attendees are currently cancelled.</p>
  <% } else { %>
    <ul class="m-0 grid list-none gap-3 p-0">
      <% groups.cancelled.forEach((person) => { %>
        <li class="flex items-center justify-between rounded-lg border border-rose-200 bg-white p-4">
          <span class="font-semibold text-slate-900"><%= person.displayName ?? person.userId %></span>
          <span class="text-sm text-slate-500"><%= person.createdAt.toLocaleString() %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
