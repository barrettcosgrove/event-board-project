<% const isPast=variant==="past" ; const isDraft=variant==="draft" ; const headerColors={
  published: "text-emerald-700 bg-emerald-50" , draft: "text-yellow-700 bg-yellow-50" , past: "text-red-700 bg-red-50"
  }; const headerStyle=headerColors[variant] || "text-slate-700 bg-slate-50" ; %>

  <section class="mb-6" <% if (typeof collapsible !=="undefined" && collapsible) { %>
    x-data="{ open: false }"
    <% } %>
      >

      <!-- SECTION HEADER -->
      <div class="flex items-center justify-between mb-3">

        <h2 class="text-xl font-semibold <%= headerStyle.split(' ')[0] %>">
          <%= title %>
        </h2>

        <% if (typeof collapsible !=="undefined" && collapsible) { %>
          <button @click="open = !open"
            class="flex items-center gap-2 text-red-600 text-sm px-3 py-1.5 rounded-lg border border-red-200 hover:bg-red-50 transition-colors">
            <span x-text="open ? 'Hide' : 'Show'"></span>

            <svg class="w-4 h-4 transition-transform duration-200" :class="open ? 'rotate-180' : ''" fill="none"
              stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <% } %>

      </div>

      <!-- COLLAPSIBLE WRAP -->
      <div <% if (typeof collapsible !=="undefined" && collapsible) { %>
        x-show="open"
        x-transition
        <% } %>
          >

          <% if (items.length===0) { %>

            <p class="text-slate-400 text-sm py-4">
              <%= emptyMessage %>
            </p>

            <% } else { %>

              <div class="overflow-x-auto rounded-xl border border-slate-200">

                <table class="min-w-full table-fixed divide-y divide-slate-200 text-sm">

                  <!-- HEADER -->
                  <thead class="bg-slate-50 text-slate-500 uppercase text-xs tracking-wide">
                    <tr>
                      <th class="px-4 py-3 text-left w-2/5">Event</th>
                      <th class="px-4 py-3 text-left w-1/6">Date</th>
                      <th class="px-4 py-3 text-left w-1/6">Category</th>
                      <th class="px-4 py-3 text-left w-1/6">Attendance</th>
                      <th class="px-4 py-3 text-left w-1/6">Actions</th>
                    </tr>
                  </thead>

                  <!-- BODY -->
                  <tbody class="divide-y divide-slate-100 bg-white">

                    <% items.forEach(function(item) { %>

                      <% const event=item.event || item; const attendeeCount=item.attendeeCount ?? 0; const
                        capacity=event.capacity; const attendanceLabel=capacity !=null ? attendeeCount + " / " +
                        capacity : attendeeCount + " attending" ; const isFull=capacity !=null && attendeeCount>=
                        capacity;
                        %>

                        <tr class="transition-all duration-150 hover:bg-slate-50 hover:shadow-sm">

                          <!-- EVENT -->
                          <td class="px-4 py-4">

                            <a href="/events/<%= event.id %>"
                              class="text-lg font-bold text-slate-900 hover:text-slate-700 transition-colors">
                              <%= event.title %>
                            </a>

                            <div class="text-xs text-slate-500 mt-1">
                              <%= event.location %>
                            </div>

                          </td>

                          <!-- DATE -->
                          <td class="px-4 py-4 text-slate-600 whitespace-nowrap">
                            <%= event.startDatetime.toLocaleDateString("en-US", { month: "short" , day: "numeric" ,
                              year: "numeric" }) %>
                          </td>

                          <!-- CATEGORY -->
                          <td class="px-4 py-4">
                            <%- include("../../partials/category-badge", { category: event.category }) %>
                          </td>

                          <!-- ATTENDANCE -->
                          <td class="px-4 py-4 text-slate-600">
                            <span class="<%= isFull ? 'text-red-500 font-medium' : '' %>">
                              <%= attendanceLabel %>
                            </span>
                          </td>

                          <!-- ACTIONS -->
                          <td class="px-4 py-4 flex gap-2 flex-wrap">

                            <% if (showPublish) { %>
                              <form method="POST" action="/events/<%= event.id %>/publish">
                                <button
                                  class="text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors">
                                  Publish
                                </button>
                              </form>
                              <% } %>

                                <% if (showCancel) { %>
                                  <form method="POST" action="/events/<%= event.id %>/cancel">
                                    <button
                                      class="text-xs px-3 py-1.5 rounded-lg border border-red-300 text-red-600 hover:bg-red-50 transition-colors">
                                      Cancel
                                    </button>
                                  </form>
                                  <% } %>

                          </td>

                        </tr>

                        <% }) %>

                  </tbody>
                </table>

              </div>

              <% } %>

      </div>

  </section>